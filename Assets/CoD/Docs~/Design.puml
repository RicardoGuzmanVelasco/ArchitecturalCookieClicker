@startuml
skin rose
left to right direction

control ToggleWeapon
control Shoot

boundary WeaponHUD
boundary ToggleWeaponButton
boundary ShootButton

entity Weapon
entity Magazine
entity Equipment

entity Bullet

ShootButton --> Shoot

Shoot --> Equipment
Shoot --> Bullet
Shoot ..> Weapon
Shoot -u-> WeaponHUD

ToggleWeapon -u-> WeaponHUD
ToggleWeapon --> Equipment
ToggleWeapon ..> Weapon

Equipment --> Weapon

ToggleWeaponButton --> ToggleWeapon

Weapon --> Magazine

@enduml